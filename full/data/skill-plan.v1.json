{
  "schema_version": 1,
  "budgets": {
    "core_chars": 6000,
    "phase_chars": 4000,
    "tool_group_chars": 6000,
    "automatic_chars": 12000
  },
  "core_groups": [
    "core.bootstrap",
    "core.identity",
    "core.context_isolation",
    "core.transactions",
    "core.evidence_ruling"
  ],
  "phase_baselines": {
    "lobby": ["phase.lobby"],
    "play": ["phase.play"],
    "combat": ["phase.combat"]
  },
  "groups": {
    "core.bootstrap": {
      "load_policy": "session",
      "visibility": "public",
      "reason": "Every zero-knowledge session needs the MCP bootstrap and exposure lifecycle.",
      "depends_on": [],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/core/bootstrap.md", "action": "read", "max_chars": 2000}]
    },
    "core.identity": {
      "load_policy": "session",
      "visibility": "public",
      "reason": "Identity, role, audience, and actor-knowledge boundaries apply to every phase.",
      "depends_on": ["core.bootstrap"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/core/identity.md", "action": "read", "max_chars": 1600}]
    },
    "core.context_isolation": {
      "load_policy": "session",
      "visibility": "public",
      "reason": "Campaign, principal, role, audience, branch, and restore boundaries must not inherit unrelated host memory or model context.",
      "depends_on": ["core.bootstrap", "core.identity"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/core/context-isolation.md", "action": "read", "max_chars": 2200}]
    },
    "core.transactions": {
      "load_policy": "session",
      "visibility": "public",
      "reason": "Every mutation must preserve revisions, idempotency, random receipts, and branch isolation.",
      "depends_on": ["core.bootstrap"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/core/transactions.md", "action": "read", "max_chars": 1800}]
    },
    "core.evidence_ruling": {
      "load_policy": "session",
      "visibility": "public",
      "reason": "Every host must distinguish engine mechanics, Agent DM rulings, and external choices.",
      "depends_on": ["core.bootstrap"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/core/evidence-ruling.md", "action": "read", "max_chars": 1800}]
    },
    "phase.lobby": {
      "load_policy": "phase",
      "visibility": "public",
      "reason": "Lobby has source, party, rule-lock, and readiness gates before live play.",
      "depends_on": ["core.bootstrap", "core.transactions"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/phase/lobby.md", "action": "read", "max_chars": 1800}]
    },
    "phase.play": {
      "load_policy": "phase",
      "visibility": "member",
      "reason": "Play needs the scene turn loop and continuity discipline.",
      "depends_on": ["core.identity", "core.transactions", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/phase/play.md", "action": "read", "max_chars": 1800}]
    },
    "phase.combat": {
      "load_policy": "phase",
      "visibility": "member",
      "reason": "Combat needs current-turn, choice-window, resource, and closeout invariants.",
      "depends_on": ["core.identity", "core.transactions", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/phase/combat.md", "action": "read", "max_chars": 1800}]
    },
    "campaign.bootstrap": {
      "load_policy": "tool_group",
      "visibility": "public",
      "reason": "An unbound Lobby session needs only system selection and campaign creation guidance.",
      "depends_on": ["phase.lobby", "core.identity", "core.transactions"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/lobby/campaign-bootstrap.md", "action": "read", "max_chars": 1600}]
    },
    "campaign.lifecycle": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "Campaign administration changes rule locks, branches, Snapshots, manifest, or membership.",
      "depends_on": ["phase.lobby", "core.identity", "core.transactions"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/lobby/campaign-lifecycle.md", "action": "read", "max_chars": 2200}]
    },
    "character.build": {
      "load_policy": "tool_group",
      "visibility": "member",
      "reason": "Character creation must prefer reviewed presets and preserve legal diverse construction.",
      "depends_on": ["phase.lobby", "core.transactions", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/lobby/character-build.md", "action": "read", "max_chars": 2000}]
    },
    "portable.content": {
      "load_policy": "tool_group",
      "visibility": "member",
      "reason": "Portable actor cards, preset, module, and rule packages require fresh identities, checksum validation, lifecycle isolation, and knowledge isolation.",
      "depends_on": ["core.identity", "core.transactions"],
      "documents": [
        {"kind": "asset", "identifier": "dnd:full/references/skill-groups/lobby/portable-content.md", "action": "section", "heading": "Actors and modules", "max_chars": 3000},
        {"kind": "asset", "identifier": "dnd:full/references/skill-groups/lobby/portable-content.md", "action": "section", "heading": "Rule packs, releases, and addons", "max_chars": 3800}
      ]
    },
    "content.solutions": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "Custom source cards require exact evidence, one persisted Agent-authored plan, and engine-owned execution through generic primitives.",
      "depends_on": ["core.identity", "core.transactions", "core.evidence_ruling"],
      "documents": [
        {"kind": "asset", "identifier": "dnd:full/references/skill-groups/core/content-solutions.md", "action": "read", "max_chars": 2400}
      ]
    },
    "addon.actors": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "Reviewed addon actor templates require DM-authorized instantiation, exact package locks, fresh campaign identities, and isolated actor knowledge.",
      "depends_on": ["core.identity", "core.transactions"],
      "documents": [
        {"kind": "asset", "identifier": "dnd:full/references/skill-groups/lobby/portable-content.md", "action": "section", "heading": "Actors and modules", "max_chars": 2500}
      ]
    },
    "rules.import": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "Rule sources require ordered import, OCR review, compilation, tests, and exact locks.",
      "depends_on": ["phase.lobby", "core.transactions", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/lobby/rules-import.md", "action": "read", "max_chars": 2200}]
    },
    "modules.import": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "Module sources and assets require reviewed import, metadata extraction, and runtime validation.",
      "depends_on": ["phase.lobby", "core.transactions", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/lobby/modules-import.md", "action": "read", "max_chars": 2400}]
    },
    "continuity.read": {
      "load_policy": "tool_group",
      "visibility": "member",
      "reason": "Narration must use current branch-, audience-, scope-, and actor-safe continuity.",
      "depends_on": ["core.identity"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/shared/continuity-read.md", "action": "read", "max_chars": 2000}]
    },
    "continuity.write": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "Durable narrative writes need atomic facts, knowledge, events, and signed source context.",
      "depends_on": ["continuity.read", "core.transactions", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/shared/continuity-write.md", "action": "read", "max_chars": 2200}]
    },
    "npc.portrayal": {
      "load_policy": "operation",
      "visibility": "dm",
      "reason": "An NPC turn needs actor-scoped context, tool-free isolated portrayal, public mechanical resolution, and explicit accepted deltas.",
      "depends_on": ["continuity.read", "continuity.write", "core.context_isolation", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/play/npc-portrayal.md", "action": "read", "max_chars": 3600}]
    },
    "evaluation.actor": {
      "load_policy": "operation",
      "visibility": "dm",
      "reason": "An autonomous NPC or monster decision needs actor-scoped context and a proposal-only host evaluation.",
      "depends_on": ["continuity.read", "core.context_isolation", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/play/actor-evaluation.md", "action": "read", "max_chars": 2200}]
    },
    "evaluation.audience": {
      "load_policy": "operation",
      "visibility": "member",
      "reason": "Player-facing narration must be generated only from an audience-filtered projection and published unchanged after validation.",
      "depends_on": ["continuity.read", "core.context_isolation"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/play/audience-render.md", "action": "read", "max_chars": 1800}]
    },
    "evaluation.faction": {
      "load_policy": "operation",
      "visibility": "dm",
      "reason": "A faction decision needs faction-owned state and knowledge without access to unrelated world truth.",
      "depends_on": ["continuity.read", "continuity.write", "core.context_isolation", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/play/faction-evaluation.md", "action": "read", "max_chars": 2200}]
    },
    "evaluation.source": {
      "load_policy": "operation",
      "visibility": "dm",
      "reason": "Source interpretation must remain exact-evidence-bound and must not activate or execute content.",
      "depends_on": ["continuity.read", "core.context_isolation", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/shared/source-interpretation.md", "action": "read", "max_chars": 2000}]
    },
    "evaluation.ruling": {
      "load_policy": "operation",
      "visibility": "dm",
      "reason": "An Agent-owned DM boundary needs a proposal-only ruling while engine mechanics remain authoritative.",
      "depends_on": ["continuity.read", "core.context_isolation", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/shared/bounded-ruling.md", "action": "read", "max_chars": 2000}]
    },
    "snapshot.branch": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "Save, restore, fork, and comparison operations must preserve Snapshot DAG isolation.",
      "depends_on": ["core.transactions"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/shared/snapshot-branch.md", "action": "read", "max_chars": 2200}]
    },
    "source.content_review": {
      "load_policy": "operation",
      "visibility": "dm",
      "reason": "OCR recovery and Agent-filled custom cards need one phase-neutral evidence review boundary.",
      "depends_on": ["core.transactions", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/shared/source-content-review.md", "action": "read", "max_chars": 2200}]
    },
    "scene.play": {
      "load_policy": "tool_group",
      "visibility": "member",
      "reason": "Live scenes need exact evidence, audience-safe narration, and disciplined progress writes.",
      "depends_on": ["phase.play", "continuity.read", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/play/scene-play.md", "action": "read", "max_chars": 2200}]
    },
    "character.state": {
      "load_policy": "tool_group",
      "visibility": "member",
      "reason": "Out-of-combat resources, rests, preparation, and inventory need canonical state mutations.",
      "depends_on": ["core.transactions"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/play/character-state.md", "action": "read", "max_chars": 2200}]
    },
    "resolution.checks": {
      "load_policy": "tool_group",
      "visibility": "member",
      "reason": "Checks and contests need evidence, meaningful stakes, and server-owned dice.",
      "depends_on": ["phase.play", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/play/resolution-checks.md", "action": "read", "max_chars": 2000}]
    },
    "combat.prepare": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "Combat start needs reviewed actors, encounter evidence, and temporary-map provenance.",
      "depends_on": ["phase.play", "scene.play", "core.transactions", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/play/combat-prepare.md", "action": "read", "max_chars": 2200}]
    },
    "chase.run": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "The chase facade has a source-reviewed theater-of-the-mind transaction loop.",
      "depends_on": ["phase.play", "core.transactions", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/play/chase.md", "action": "read", "max_chars": 2200}]
    },
    "combat.observe": {
      "load_policy": "tool_group",
      "visibility": "member",
      "reason": "Combat decisions begin from current audience-safe encounter and turn state.",
      "depends_on": ["phase.combat", "continuity.read"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/combat/observe.md", "action": "read", "max_chars": 2000}]
    },
    "combat.turn": {
      "load_policy": "tool_group",
      "visibility": "member",
      "reason": "Turn advancement, ready actions, and choices must preserve open transaction windows.",
      "depends_on": ["phase.combat", "core.transactions"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/combat/turn.md", "action": "read", "max_chars": 2200}]
    },
    "combat.actions": {
      "load_policy": "tool_group",
      "visibility": "member",
      "reason": "Structured combat actions separate Agent intent from engine-owned mechanics and payment.",
      "depends_on": ["phase.combat", "core.transactions", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/combat/actions.md", "action": "read", "max_chars": 2400}]
    },
    "combat.control": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "Reinforcement and combat closeout need audited actor, outcome, and continuity boundaries.",
      "depends_on": ["phase.combat", "continuity.write", "core.transactions"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/combat/control.md", "action": "read", "max_chars": 2200}]
    },
    "combat.map": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "Temporary map patches require evidence, layer separation, and revision-safe geometry.",
      "depends_on": ["phase.combat", "core.transactions", "core.evidence_ruling"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/combat/map.md", "action": "read", "max_chars": 2200}]
    },
    "runtime.maintenance": {
      "load_policy": "tool_group",
      "visibility": "dm",
      "reason": "Built-in Core relock is an explicit checkpointed runtime upgrade.",
      "depends_on": ["phase.combat", "snapshot.branch", "core.transactions"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/combat/maintenance.md", "action": "read", "max_chars": 2200}]
    },
    "storage.admin": {
      "load_policy": "tool_group",
      "visibility": "local_admin",
      "reason": "Schema migration is restricted local process administration.",
      "depends_on": ["core.identity", "core.transactions"],
      "documents": [{"kind": "asset", "identifier": "dnd:full/references/skill-groups/admin/storage.md", "action": "read", "max_chars": 1600}]
    }
  },
  "tool_group_bindings": {
    "lobby.bootstrap": {"required": ["campaign.bootstrap"], "tools": ["campaign_create", "system_list"]},
    "lobby.campaign": {"required": ["campaign.lifecycle", "snapshot.branch"], "tools": ["access_grant", "branch_change", "branch_query", "campaign_change", "campaign_event", "campaign_rules", "playthrough_manifest", "snapshot_create", "snapshot_query", "snapshot_restore", "state_revision"]},
    "lobby.characters": {"required": ["character.build", "portable.content"], "tools": ["character_ability_apply", "character_action", "character_content_apply", "character_create_from", "character_metadata_update", "character_query", "character_sheet_replace", "character_spell_prepare", "character_state_change", "dnd_ability_roll", "dnd_dice_roll", "inventory_change", "inventory_transfer", "wallet_change"]},
    "lobby.addon_actors": {"required": ["addon.actors"], "tools": ["addon_actor_instantiate"]},
    "lobby.rules": {"required": ["rules.import", "portable.content"], "tools": ["campaign_rules", "content_solution", "import_query", "rule_expand", "rule_import", "rule_pack_change", "rule_pack_compile", "rule_pack_query", "rule_search", "rule_seed_bundled", "rule_seed_status"]},
    "lobby.modules": {"required": ["modules.import", "portable.content"], "tools": ["module_expand", "module_import", "module_query", "module_review", "module_search", "module_set_progress"]},
    "lobby.memory": {"required": ["continuity.read"], "tools": ["actor_knowledge_query", "bounded_evaluation", "continuity_context"]},
    "lobby.memory_control": {"required": ["continuity.write"], "tools": ["actor_knowledge_change", "memory_change", "memory_query"]},
    "lobby.storage_admin": {"required": ["storage.admin"], "tools": ["storage_migrate"]},
    "play.scene": {"required": ["scene.play", "continuity.read"], "tools": ["actor_knowledge_query", "bounded_evaluation", "branch_query", "campaign_event", "continuity_context", "module_expand", "module_query", "module_search"]},
    "play.scene_control": {"required": ["scene.play", "continuity.write", "snapshot.branch", "content.solutions"], "tools": ["actor_knowledge_change", "campaign_change", "campaign_rules", "content_solution", "memory_change", "memory_query", "module_review", "module_set_progress", "playthrough_manifest", "snapshot_create", "snapshot_query", "state_revision"]},
    "play.characters": {"required": ["character.state"], "tools": ["character_action", "character_content_apply", "character_metadata_update", "character_query", "character_state_change", "inventory_change", "inventory_transfer", "wallet_change"]},
    "play.addon_actors": {"required": ["addon.actors"], "tools": ["addon_actor_instantiate"]},
    "play.resolution": {"required": ["resolution.checks"], "tools": ["character_check", "dnd_ability_roll", "dnd_check", "dnd_dice_roll", "rule_expand", "rule_search"]},
    "play.combat_control": {"required": ["combat.prepare"], "tools": ["combat_start"]},
    "play.chase": {"required": ["chase.run"], "tools": ["chase"]},
    "combat.observe": {"required": ["combat.observe"], "tools": ["actor_knowledge_query", "bounded_evaluation", "branch_query", "character_query", "combat_query", "continuity_context", "module_query", "module_search", "rule_expand", "rule_search"]},
    "combat.turn": {"required": ["combat.turn"], "tools": ["combat_choice", "combat_end_turn", "combat_ready"]},
    "combat.control": {"required": ["combat.control", "content.solutions"], "tools": ["addon_actor_instantiate", "combat_end", "combat_join", "content_solution"]},
    "combat.actions": {"required": ["combat.actions"], "tools": ["combat_cast_spell", "combat_check", "combat_choice", "combat_common_action", "combat_concentration_check", "combat_hp_change", "combat_movement", "combat_preflight_attack", "combat_reaction_attack", "combat_resolve_attack", "combat_use_activity", "dnd_check", "dnd_dice_roll"]},
    "combat.save": {"required": ["snapshot.branch"], "tools": ["branch_change", "playthrough_manifest", "snapshot_create", "snapshot_query", "snapshot_restore"]},
    "combat.maintenance": {"required": ["runtime.maintenance"], "tools": ["campaign_rules"]},
    "combat.map": {"required": ["combat.map"], "tools": ["combat_map_patch"]}
  },
  "operation_bindings": {
    "campaign_query:resume": ["continuity.read", "snapshot.branch"],
    "continuity_context:npc_turn": ["npc.portrayal"],
    "continuity_context:actor_turn": ["evaluation.actor"],
    "continuity_context:audience_render": ["evaluation.audience"],
    "continuity_context:faction_turn": ["evaluation.faction"],
    "continuity_context:source_interpretation": ["evaluation.source"],
    "continuity_context:bounded_ruling": ["evaluation.ruling"],
    "campaign_change:party_rest": ["character.state"],
    "character_create_from:module_statblock": ["source.content_review"],
    "character_create_from:reviewed_rule_statblock": ["source.content_review"],
    "character_create_from:statblock": ["source.content_review"],
    "memory_change:commit": ["continuity.write"],
    "module_review:recover_statblock": ["source.content_review"],
    "module_review:render_transcript": ["source.content_review"],
    "module_review:submit_content": ["source.content_review"],
    "module_review:submit_transcript": ["source.content_review"],
    "rule_import:recover_statblock": ["source.content_review"],
    "rule_import:render_page": ["source.content_review"],
    "rule_import:review_text": ["source.content_review"],
    "content_solution:compile": ["core.evidence_ruling"],
    "combat_start:started": ["combat.observe"],
    "combat_end:closed": ["scene.play", "continuity.write"],
    "combat_choice:on_hit_ruling": ["combat.actions"],
    "combat_choice:execute_plan": ["combat.actions"],
    "chase:start": ["chase.run"]
  }
}
